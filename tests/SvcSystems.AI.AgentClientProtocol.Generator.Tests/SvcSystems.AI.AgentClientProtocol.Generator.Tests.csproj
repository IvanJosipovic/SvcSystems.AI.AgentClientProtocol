<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.10.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\SvcSystems.AI.AgentClientProtocol.Generator\SvcSystems.AI.AgentClientProtocol.Generator.csproj" />
  </ItemGroup>
  <Target Name="ReferenceJsonSourceGeneratorForTests"
          BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <Reference Include="@(Analyzer->WithMetadataValue('Filename', 'System.Text.Json.SourceGeneration'))"
                 Private="true" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="..\..\schema\acp\v1\schema.json" Link="acp-v1.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schema\acp\v1\schema.generator.json" Link="acp-v1.generator.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
