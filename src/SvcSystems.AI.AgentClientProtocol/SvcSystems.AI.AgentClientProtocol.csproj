<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>SvcSystems.AI.AgentClientProtocol</PackageId>
    <Authors>SVCSystems</Authors>
    <Description>A NativeAOT-compatible .NET client for the Agent Client Protocol.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ACP;Agent Client Protocol;AI;stdio</PackageTags>
    <RepositoryUrl>https://github.com/IvanJosipovic/SVCSystems.AI.AgentClientProtocol</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the output of source generators from the compilation -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SvcSystems.AI.AgentClientProtocol.Tests" />
    <InternalsVisibleTo Include="SvcSystems.AI.AgentClientProtocol.Agent" />
    <AdditionalFiles Include="..\..\schema\**\*.schema.json" />
    <AdditionalFiles Include="..\..\schema\**\schema.json" />
    <AdditionalFiles Include="..\..\schema\**\*.generator.json" />
    <AdditionalFiles Include="..\..\schema\**\*.meta.json" />
    <AdditionalFiles Include="..\..\schema\**\meta.json" />
    <ProjectReference Include="..\..\tools\SvcSystems.AI.AgentClientProtocol.Generator\SvcSystems.AI.AgentClientProtocol.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <Target Name="AddProtocolGeneratorDependencies" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Include="$(MSBuildProjectDirectory)\..\..\tools\SvcSystems.AI.AgentClientProtocol.Generator\bin\$(Configuration)\netstandard2.0\*.dll"
                Exclude="$(MSBuildProjectDirectory)\..\..\tools\SvcSystems.AI.AgentClientProtocol.Generator\bin\$(Configuration)\netstandard2.0\SvcSystems.AI.AgentClientProtocol.Generator.dll;$(MSBuildProjectDirectory)\..\..\tools\SvcSystems.AI.AgentClientProtocol.Generator\bin\$(Configuration)\netstandard2.0\Microsoft.CodeAnalysis*.dll" />
    </ItemGroup>
  </Target>

  <!--
    EmitCompilerGeneratedFiles persists every generator's output into $(CompilerGeneratedFilesOutputPath).
    We only commit this project's own generator output; framework output (e.g. the System.Text.Json
    source generator) is pruned so the committed tree stays review-sized. The exclusion below keys off
    *our* generator's folder so an SDK/inbox generator rename cannot reintroduce framework files.
  -->
  <Target Name="PruneFrameworkGeneratedFiles" AfterTargets="CoreCompile">
    <ItemGroup>
      <_FirstPartyGenerated Include="$(CompilerGeneratedFilesOutputPath)\SvcSystems.AI.AgentClientProtocol.Generator\**\*.cs" />
      <_FrameworkGenerated Include="$(CompilerGeneratedFilesOutputPath)\**\*.cs"
                           Exclude="@(_FirstPartyGenerated)" />
    </ItemGroup>
    <Delete Files="@(_FrameworkGenerated)" />
    <RemoveDir Directories="$(CompilerGeneratedFilesOutputPath)\System.Text.Json.SourceGeneration"
               Condition="Exists('$(CompilerGeneratedFilesOutputPath)\System.Text.Json.SourceGeneration')" />
  </Target>
</Project>
