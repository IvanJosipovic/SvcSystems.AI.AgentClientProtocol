<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>SvcSystems.AI.AgentClientProtocol</PackageId>
    <Authors>SVCSystems</Authors>
    <Description>A NativeAOT-compatible .NET client for the Agent Client Protocol.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ACP;Agent Client Protocol;AI;stdio</PackageTags>
    <RepositoryUrl>https://github.com/IvanJosipovic/SVCSystems.AI.AgentClientProtocol</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <DefineConstants>$(DefineConstants);ACP_STJ_SOURCE_GEN;ACP_CLIENT_ADAPTERS</DefineConstants>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <!-- Exclude the output of source generators from the compilation -->
        <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
    </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SvcSystems.AI.AgentClientProtocol.Tests" />
    <AdditionalFiles Include="..\..\schema\v1\schema.json" />
    <AdditionalFiles Include="..\..\schema\v1\schema.generator.json" />
    <ProjectReference Include="..\..\tools\SvcSystems.AI.AgentClientProtocol.Generator\SvcSystems.AI.AgentClientProtocol.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <Target Name="AddProtocolGeneratorDependencies" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Include="$(MSBuildProjectDirectory)\..\..\tools\SvcSystems.AI.AgentClientProtocol.Generator\bin\$(Configuration)\netstandard2.0\*.dll"
                Exclude="$(MSBuildProjectDirectory)\..\..\tools\SvcSystems.AI.AgentClientProtocol.Generator\bin\$(Configuration)\netstandard2.0\SvcSystems.AI.AgentClientProtocol.Generator.dll;$(MSBuildProjectDirectory)\..\..\tools\SvcSystems.AI.AgentClientProtocol.Generator\bin\$(Configuration)\netstandard2.0\Microsoft.CodeAnalysis*.dll" />
    </ItemGroup>
  </Target>
</Project>
